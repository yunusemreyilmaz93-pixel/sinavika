{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/rapor/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/hakkinda",
      "destination": "/hakkinda.html"
    },
    {
      "source": "/kvkk",
      "destination": "/kvkk.html"
    },
    {
      "source": "/giris",
      "destination": "/giris.html"
    },
    {
      "source": "/katil",
      "destination": "/katil.html"
    },
    {
      "source": "/test-giris",
      "destination": "/test-giris.html"
    },
    {
      "source": "/ogretmen-basvurusu",
      "destination": "/ogretmen-basvurusu.html"
    },
    {
      "source": "/konu-anlatimi",
      "destination": "/konu-anlatimi.html"
    },
    {
      "source": "/konu-anlatimi/:exam",
      "destination": "/konu-anlatimi/:exam.html"
    },
    {
      "source": "/konu-anlatimi/:exam/:subject",
      "destination": "/konu-anlatimi/:exam/:subject.html"
    },
    {
      "source": "/konu-anlatimi/:exam/:subject/:topic",
      "destination": "/konu-anlatimi/:exam/:subject/:topic.html"
    },
    {
      "source": "/araclar/:tool",
      "destination": "/araclar/:tool.html"
    },
    {
      "source": "/calisma-programlari",
      "destination": "/calisma-programlari.html"
    },
    {
      "source": "/calisma-programlari/:slug",
      "destination": "/calisma-programlari/:slug.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "17 6 * * *"
    }
  ],
  "functions": {
    "api/ai.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/app/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/rapor/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
