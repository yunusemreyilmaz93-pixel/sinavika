{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "izlek",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/app", "/app/*", "/rapor/*"]
  },
  "routes": [
    { "pattern": "izlek.site", "custom_domain": true },
    { "pattern": "www.izlek.site", "custom_domain": true }
  ],
  "triggers": { "crons": ["17 6 * * *"] },
  "vars": { "SITE_URL": "https://izlek.site", "SUPABASE_URL": "https://obrpascjokzoalfmwhjf.supabase.co" },
  "observability": { "enabled": true }
}
